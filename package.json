{
  "name": "michelin-eval",
  "version": "0.1.0",
  "description": "Eval harness for AI agents: describe user journeys in plain words, LLM judges score the evidence.",
  "license": "MIT",
  "keywords": [
    "eval",
    "llm",
    "agents",
    "claude",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishansubudhi/michelin.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "prettier": {
    "printWidth": 120
  },
  "files": [
    "bin",
    "src",
    "skills",
    "defaults",
    "subjects/toy"
  ],
  "bin": {
    "michelin": "bin/michelin.js"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:integration": "node --test test/integration/integration.test.ts",
    "lint": "tsc --noEmit && eslint . && prettier --ignore-path .gitignore --ignore-path prettierignore --check .",
    "format": "prettier --ignore-path .gitignore --ignore-path prettierignore --write .",
    "css": "node scripts/build-css.ts",
    "prepare": "git config core.hooksPath hooks"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "^0.1.24",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
